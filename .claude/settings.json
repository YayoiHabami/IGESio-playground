{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-branch-on-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-branch-on-commit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(*--force*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/rules/**)"
    ],
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git checkout -b:*)",
      "Read(docs/**)",
      "Read(py_igesio/**)"
    ]
  }
}
